+    async def compare_and_swap_preference(
+        self, scope, scope_id, key, expected, replacement
+    ) -> bool:
+        """Replace an existing preference within a SQLite write transaction.
+
+        Args:
+            scope: Plugin namespace.
+            scope_id: Owning plugin identifier.
+            key: Bounded response preference key.
+            expected: Expected JSON envelope.
+            replacement: Replacement JSON envelope.
+
+        Returns:
+            True after commit; False on missing or mismatched data.
+
+        Raises:
+            ValueError: Unsupported namespace or invalid JSON.
+            Exception: Database failure; commit failures may be ambiguous.
+        """
+        if scope != "plugin" or key != "response_style_preference:v1" or not scope_id:
+            raise ValueError(
+                "conditional writes are restricted to response preferences"
+            )
+        expected_json = json.dumps(
+            expected,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        )
+        json.dumps(replacement, allow_nan=False)
+        async with self.get_db() as session:
+            try:
+                # Reserve the writer before comparison, including other processes.
+                await session.execute(text("BEGIN IMMEDIATE"))
+                result = await session.execute(
+                    select(Preference).where(
+                        Preference.scope == scope,
+                        Preference.scope_id == scope_id,
+                        Preference.key == key,
+                    )
+                )
+                row = result.scalar_one_or_none()
+                if (
+                    row is None
+                    or json.dumps(
+                        row.value,
+                        sort_keys=True,
+                        separators=(",", ":"),
+                        ensure_ascii=False,
+                        allow_nan=False,
+                    )
+                    != expected_json
+                ):
+                    await session.rollback()
+                    return False
+                row.value = replacement
+                await session.commit()
+                return True
+            except BaseException:
+                await session.rollback()
+                raise
+
