+@pytest.mark.asyncio
+async def test_response_cas_missing_conflict_commit_and_committed_read(preferences):
+    store, database = preferences
+    key = "response_style_preference:v1"
+    before, after = {"version": 1}, {"version": 2}
+    assert not await store.compare_and_swap_async(
+        "plugin", "fixture-owner", key, before, after
+    )
+    await store.put_async("plugin", "fixture-owner", key, before)
+    assert not await store.compare_and_swap_async(
+        "plugin", "fixture-owner", key, after, before
+    )
+    assert await store.compare_and_swap_async(
+        "plugin", "fixture-owner", key, before, after
+    )
+    assert await store.get_async("plugin", "fixture-owner", key) == after
+    assert ("plugin", "fixture-owner", key) not in store._cache
+    assert not await store.compare_and_swap_async(
+        "plugin", "other-owner", key, before, after
+    )
+    assert (await database.get_preference("plugin", "fixture-owner", key)).value == {
+        "val": after
+    }
+
+
+@pytest.mark.asyncio
+async def test_response_cas_independent_engines_have_one_winner(preferences):
+    store, database = preferences
+    key = "response_style_preference:v1"
+    before = {"state": "APPROVED"}
+    await store.put_async("plugin", "fixture-owner", key, before)
+    peer = SQLiteDatabase(database.db_path)
+    await peer.initialize()
+    peer.inited = True
+    try:
+        results = await asyncio.gather(
+            database.compare_and_swap_preference(
+                "plugin",
+                "fixture-owner",
+                key,
+                {"val": before},
+                {"val": {"winner": "a"}},
+            ),
+            peer.compare_and_swap_preference(
+                "plugin",
+                "fixture-owner",
+                key,
+                {"val": before},
+                {"val": {"winner": "b"}},
+            ),
+        )
+        assert sorted(results) == [False, True]
+        committed = (await peer.get_preference("plugin", "fixture-owner", key)).value[
+            "val"
+        ]
+        assert await store.get_async("plugin", "fixture-owner", key) == committed
+    finally:
+        await peer.engine.dispose()
+
+
+@pytest.mark.asyncio
+async def test_response_cas_preserves_fifo_with_ordinary_writes(preferences):
+    store, _database = preferences
+    key = "response_style_preference:v1"
+    await store.put_async("plugin", "fixture-owner", key, {"version": 0})
+    # The deprecated sync writer still enters the same FIFO, without a cache overlay.
+    store.put(key, {"version": 1}, scope="plugin", scope_id="fixture-owner")
+    assert await store.compare_and_swap_async(
+        "plugin", "fixture-owner", key, {"version": 1}, {"version": 2}
+    )
+    assert await store.get_async("plugin", "fixture-owner", key) == {"version": 2}
+
+
+@pytest.mark.asyncio
+async def test_response_cas_failure_does_not_poison_cache_or_writer(
+    preferences, monkeypatch
+):
+    store, database = preferences
+    key = "response_style_preference:v1"
+    await store.put_async("plugin", "fixture-owner", key, {"version": 1})
+
+    async def fail(*_args):
+        raise OSError("injected before commit")
+
+    monkeypatch.setattr(database, "compare_and_swap_preference", fail)
+    with pytest.raises(OSError):
+        await store.compare_and_swap_async(
+            "plugin", "fixture-owner", key, {"version": 1}, {"version": 2}
+        )
+    assert await store.get_async("plugin", "fixture-owner", key) == {"version": 1}
+    await store.put_async("plugin", "fixture-owner", key, {"version": 3})
+    assert await store.get_async("plugin", "fixture-owner", key) == {"version": 3}
+
