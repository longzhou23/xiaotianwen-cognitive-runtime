+    async def compare_and_swap_async(
+        self, scope: str, scope_id: str, key: str, expected: Any, replacement: Any
+    ) -> bool:
+        """Serialize CAS with preceding ordinary writes without speculative caching.
+
+        Args:
+            scope: Plugin namespace.
+            scope_id: Owning plugin identifier.
+            key: Bounded response preference key.
+            expected: Expected committed payload.
+            replacement: Desired payload.
+
+        Returns:
+            True after commit or False on comparison miss.
+
+        Raises:
+            ValueError: Unsupported scope.
+            NotImplementedError: Unsupported backend.
+        """
+        if scope != "plugin" or key != "response_style_preference:v1" or not scope_id:
+            raise ValueError(
+                "conditional writes are restricted to response preferences"
+            )
+        if not callable(getattr(self.db_helper, "compare_and_swap_preference", None)):
+            raise NotImplementedError("database backend lacks conditional writes")
+        await self.initialize()
+        completion = asyncio.get_running_loop().create_future()
+        self._submit_write(
+            (
+                "cas",
+                scope,
+                scope_id,
+                key,
+                (deepcopy(expected), deepcopy(replacement)),
+                completion,
+            )
+        )
+        # Cancellation cannot cancel a transaction already queued for commit.
+        return await asyncio.shield(completion)
+
